---
import { SITE } from '../config/site';
import { MESSENGER_LINKS } from '../data/messengers';
import { COMPANY_LINKS, DIRECTION_LINKS, POLICY_LINK } from '../data/nav';

const year = new Date().getFullYear();
// Тап-таргет 44px: ссылки подвала — самостоятельные пункты списков, а не текст в предложении.
const link =
  'flex min-h-[44px] items-center text-[14.5px] text-text transition-colors duration-200 hover:text-screen';
const label = 'mb-3.5 font-mono text-[11px] tracking-[0.12em] text-dim uppercase';
---

<footer class="mt-20 border-t border-line bg-bg-deep">
  <div
    class="mx-auto grid max-w-[1200px] grid-cols-1 gap-8 px-4 pt-11 pb-7 sm:grid-cols-2 sm:px-6 lg:grid-cols-4"
  >
    <div>
      <div class="mb-3.5 flex items-center gap-2.5">
        <span
          class="h-[18px] w-[26px] rounded-[3px] bg-[linear-gradient(160deg,var(--color-focus),var(--color-accent))]"
          aria-hidden="true"></span>
        <span class="font-display text-[15px] font-semibold text-screen">{SITE.brandName}</span>
      </div>
      <p class="max-w-[30ch] sm:max-w-[34ch] text-[14px] text-dim">
        Аренда экранов и&nbsp;AV-оборудования для деловых мероприятий: плазменные панели,
        LED-экраны, тач-панели, видеотрансляции.
      </p>
      <p class="mt-3 max-w-[30ch] sm:max-w-[34ch] text-[14px] text-dim">{SITE.workArea}</p>
    </div>

    <div>
      <div class={label}>Направления</div>
      <nav aria-label="Направления" class="flex flex-col">
        {DIRECTION_LINKS.map((item) => <a href={item.href} class={link}>{item.label}</a>)}
      </nav>
    </div>

    <div>
      <div class={label}>Компания</div>
      <nav aria-label="Разделы сайта" class="flex flex-col">
        {COMPANY_LINKS.map((item) => <a href={item.href} class={link}>{item.label}</a>)}
      </nav>
    </div>

    <div>
      <div class={label}>Контакты</div>
      <a
        href={SITE.phoneHref}
        data-goal="click_phone"
        class="flex min-h-[44px] items-center font-mono text-[16px] text-screen"
        >{SITE.phone}</a
      >
      <a href={`mailto:${SITE.email}`} class={link}>{SITE.email}</a>
      <div class="mb-2 flex flex-wrap gap-x-5">
        {
          MESSENGER_LINKS.map((item) => (
            <a href={item.href} target="_blank" rel="noopener" data-goal={item.goal} class={link}>
              {item.label}
            </a>
          ))
        }
      </div>
      <p class="text-[14px] text-dim">Заявки принимаем круглосуточно</p>
    </div>
  </div>

  <div
    class="mx-auto flex max-w-[1200px] flex-wrap justify-between gap-x-6 gap-y-3 px-4 pt-6 pr-[76px] pb-[200px] font-mono text-[11.5px] text-dim sm:px-6 sm:pr-[92px] sm:pb-[140px]"
  >
    <span>© {year} {SITE.brandName} · {SITE.requisites}</span>
    <a
      href={POLICY_LINK.href}
      class="flex min-h-[44px] items-center transition-colors duration-200 hover:text-screen"
      >{POLICY_LINK.label}</a
    >
  </div>
</footer>
