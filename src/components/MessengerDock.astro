---
import { SITE } from '../config/site';

// Пиктограммы — инлайн-SVG в едином стиле, без внешних иконочных наборов.
const round =
  'flex h-[52px] w-[52px] items-center justify-center rounded-full transition-colors duration-200';
const secondary =
  'border border-line-strong bg-surface-2 text-text hover:border-line-on-strong hover:text-screen';
---

<div
  id="messenger-dock"
  role="group"
  aria-label="Написать в мессенджер"
  class="fixed right-4 bottom-4 z-[45] flex flex-col items-center gap-2.5 sm:right-6 sm:bottom-6"
>
  <a
    href={SITE.tgLink}
    target="_blank"
    rel="noopener"
    data-goal="click_tg"
    aria-label="Написать в Telegram"
    class={`${round} bg-accent text-white shadow-glow-md hover:bg-accent-soft`}
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M9.04 15.47 8.7 20.2c.5 0 .72-.22.98-.48l2.34-2.24 4.86 3.56c.89.5 1.53.24 1.77-.82l3.2-15.03c.29-1.31-.47-1.82-1.34-1.5L1.6 9.4c-1.29.5-1.27 1.22-.22 1.54l4.94 1.54 11.46-7.22c.54-.35 1.03-.16.63.2z"
      ></path>
    </svg>
  </a>

  <a
    href={SITE.waLink}
    target="_blank"
    rel="noopener"
    data-goal="click_wa"
    aria-label="Написать в WhatsApp"
    class={`${round} ${secondary}`}
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.53 15.24L2 22l4.9-1.42A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-2.9.84.86-2.83-.2-.31A8.2 8.2 0 1 1 12 20.2Z"
      ></path>
      <path
        d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.09 3.2 5.07 4.49.71.3 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35Z"
      ></path>
    </svg>
  </a>

  <a
    href={SITE.maxLink}
    target="_blank"
    rel="noopener"
    data-goal="click_max"
    aria-label="Написать в MAX"
    class={`${round} ${secondary}`}
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M12 3.2c-4.86 0-8.8 3.36-8.8 7.5 0 2.4 1.33 4.53 3.4 5.9v3.6l3.3-1.85c.67.13 1.37.2 2.1.2 4.86 0 8.8-3.36 8.8-7.5s-3.94-7.85-8.8-7.85Z"
      ></path>
      <path d="M8.7 13.2V8.9l3.3 3 3.3-3v4.3"></path>
    </svg>
  </a>
</div>
