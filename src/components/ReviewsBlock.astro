---
import { SITE } from '../config/site';
import { REVIEWS } from '../data/reviews';
import JsonLd from './seo/JsonLd.astro';

// Оценок клиент не давал — reviewRating не выдумываем.
const reviews = REVIEWS.slice(0, 3);

// itemReviewed ссылается по '@id' на узел LocalBusiness из Base.astro, а не дублирует его:
// иначе в графе — несвязанные организации, и отзывы не считаются отзывами об этом бизнесе.
const businessId = new URL('/#business', SITE.url).href;

const reviewLd = (review: (typeof REVIEWS)[number]) => ({
  '@context': 'https://schema.org',
  '@type': 'Review',
  reviewBody: review.text,
  author: { '@type': 'Person', name: review.author },
  itemReviewed: { '@id': businessId },
});
---

<div class="grid gap-bento sm:grid-cols-2 lg:grid-cols-3">
  {
    reviews.map((review) => (
      <article class="flex flex-col rounded-box border border-line bg-surface p-6">
        <blockquote class="text-[16px] leading-[1.55] text-screen">{review.text}</blockquote>
        <div class="mt-auto pt-5">
          <p class="text-[14.5px] text-text">{review.author}</p>
          <p class="mt-1 font-mono text-[12px] text-dim">
            {review.role} · {review.company}
          </p>
        </div>
      </article>
    ))
  }
</div>

{reviews.map((review) => <JsonLd data={reviewLd(review)} />)}
