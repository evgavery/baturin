---
import { SITE } from '../config/site';
import { NAV_LINKS } from '../data/nav';

// Меню шести пунктов с полными подписями требует широкой строки, поэтому инлайн-навигация
// включается с xl (1280px), ниже — бургер.
const cta =
  'min-h-[44px] items-center justify-center rounded-full bg-accent px-5 text-[14px] font-semibold whitespace-nowrap text-white transition-[background-color,box-shadow] duration-200 hover:bg-accent-soft hover:shadow-glow-md active:bg-accent-press';
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-[14px]">
  <div class="relative mx-auto flex max-w-[1200px] items-center gap-3 px-4 py-3 sm:px-6 xl:gap-4">
    <a
      href="/"
      class="flex min-h-[44px] flex-none items-center gap-2.5"
      aria-label={`${SITE.brandName} — на главную`}
    >
      <span
        class="h-[18px] w-[26px] rounded-[3px] bg-[linear-gradient(160deg,var(--color-focus),var(--color-accent))] shadow-glow-sm"
        aria-hidden="true"></span>
      <span class="font-display text-[15px] font-semibold tracking-[-0.01em] text-screen"
        >{SITE.brandName}</span
      >
    </a>

    <nav
      id="site-nav"
      aria-label="Основная навигация"
      class="absolute inset-x-0 top-full hidden flex-col border-b border-line bg-bg-deep px-4 pt-1 pb-4 data-[open]:flex sm:px-6 xl:static xl:flex xl:flex-row xl:flex-wrap xl:items-center xl:gap-3 xl:border-0 xl:bg-transparent xl:p-0"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="flex min-h-[44px] items-center border-t border-line text-[15px] text-text transition-colors duration-200 first:border-t-0 hover:text-screen xl:border-0 xl:text-[14px]"
          >
            {link.label}
          </a>
        ))
      }
      <button type="button" data-quiz-open class={`${cta} mt-3 flex xl:hidden`}
        >Получить смету</button
      >
    </nav>

    <div class="ml-auto flex items-center gap-2 xl:gap-3">
      <a
        href={SITE.phoneHref}
        data-goal="click_phone"
        aria-label={`Позвонить: ${SITE.phone}`}
        class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-line-strong font-mono text-[13.5px] whitespace-nowrap text-screen transition-colors duration-200 hover:border-line-on-strong xl:min-w-0 xl:rounded-none xl:border-0"
      >
        <svg
          class="xl:hidden"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M6.6 3.5h3l1.5 3.7-1.9 1.4a11.6 11.6 0 0 0 5.2 5.2l1.4-1.9 3.7 1.5v3a1.6 1.6 0 0 1-1.7 1.6A15.9 15.9 0 0 1 5 5.2 1.6 1.6 0 0 1 6.6 3.5Z"
          ></path>
        </svg>
        <span class="hidden xl:inline">{SITE.phone}</span>
      </a>

      <button type="button" data-quiz-open class={`${cta} hidden xl:inline-flex`}
        >Получить смету</button
      >

      <button
        type="button"
        id="nav-toggle"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Открыть меню"
        class="flex h-11 w-11 flex-none flex-col items-center justify-center gap-1 rounded-full bg-accent transition-colors duration-200 hover:bg-accent-soft xl:hidden"
      >
        <span class="block h-[1.5px] w-4 bg-white" aria-hidden="true"></span>
        <span class="block h-[1.5px] w-4 bg-white" aria-hidden="true"></span>
        <span class="block h-[1.5px] w-4 bg-white" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
