---
interface Props {
  data: object;
}

const { data } = Astro.props;
// Угловые скобки экранируются: строка с буквальным закрывающим тегом script внутри данных
// иначе досрочно закрыла бы этот <script> и сломала остаток страницы.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={json} />
