---
import { SITE } from '../config/site';

// Флагман — ТЗ §5.1 п.5. Модель и характеристики берём только из SITE.flagship: до подтверждения
// клиентом (ТЗ §8.2 п.6) там стоят заглушки, выдумывать спеки нельзя.
---

<div
  class="flagship screen-on flex h-full flex-col justify-between gap-8 rounded-box p-6 sm:p-9"
  id="flagship"
>
  <p class="font-mono text-[11.5px] tracking-[0.14em] text-screen/80 uppercase">Новинка парка</p>

  <div>
    <h2
      class="max-w-[22ch] font-display text-[clamp(26px,3.4vw,42px)] leading-[1.06] font-semibold tracking-[-0.03em] text-white"
    >
      {SITE.flagship.name}
    </h2>
    <p class="mt-4 max-w-[52ch] text-[16.5px] text-screen/90">
      Позиция под ключевые площадки: собираем нужный размер, монтируем на подвес или наземную
      конструкцию. Характеристики, комплект и стоимость фиксируем в смете под ваш зал.
    </p>
    <ul role="list" class="mt-5 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[13px] text-screen/80">
      {SITE.flagship.specs.map((spec) => <li>{spec}</li>)}
    </ul>
  </div>

  <div>
    <button
      type="button"
      data-quiz-open
      class="flex min-h-[48px] items-center justify-center rounded-full bg-screen px-7 text-[15px] font-semibold text-bg transition-colors duration-200 hover:bg-white"
      >Запросить смету</button
    >
  </div>
</div>

<style>
  /* Единственный бокс страницы с максимальным свечением (правило дизайн-системы). */
  .flagship {
    border-color: var(--color-line-on-strong);
    box-shadow: var(--shadow-glow-lg);
  }
</style>
