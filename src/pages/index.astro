---
// Временная заглушка — полноценная главная собирается в Task 4.
import { SITE } from '../config/site';
import Base from '../layouts/Base.astro';
---

<Base
  title={`Аренда экранов для мероприятий в Москве — смета за 30 минут | ${SITE.brandName}`}
  description="Плазменные панели 55–98″, LED-экраны, тач-панели и видеотрансляции в аренду. Доставка, монтаж и техник на площадке. Смета за 30 минут в Telegram, WhatsApp или MAX."
>
  <section class="mx-auto max-w-[1200px] px-4 pt-12 pb-16 sm:px-6">
    <h1 class="font-display text-[clamp(30px,4.2vw,52px)] leading-[1.05] font-semibold text-screen">
      Каркас
    </h1>
    <p class="mt-4 font-mono text-dim">Шапка, подвал, док мессенджеров и SEO-обвязка подключены</p>
  </section>
</Base>
