---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { SITE } from '../config/site';
import { AGENCY_LINK, HOME_LINK } from '../data/nav';
import Base from '../layouts/Base.astro';
import { boxClass, primaryButton, secondaryButton } from '../lib/ui';

// Страница-дифференциатор по ТЗ §5.6 — короткая, без карточек-«экранов» и без цен:
// агентство выбирает подрядчика по документам, скорости и тому, кто именно приедет
// на площадку, а не по диагоналям. Пять смысловых блоков — ровно те, что перечислены в ТЗ.
const title = `Агентствам и корпоративным заказчикам | ${SITE.brandName}`;
const description =
  'Условия для агентств, организаторов и компаний: white label, работа по ЭДО и безналу, персональный контакт без колл-центра. Смета — за 30 минут.';

const consultPreset = JSON.stringify({ services: ['consult'] });
const ctaLabel = 'Обсудить сотрудничество';

// Порядок и формулировки — ТЗ §5.6: white label → агентские условия → документы →
// скорость → персональный контакт. Цифр сверх SITE.agencyTerms не вводим (ТЗ §8.2 п.11).
const blocks = [
  {
    id: 'documents',
    kicker: 'Документы',
    title: 'Договор, безнал, ЭДО',
    text: 'Работаем с юрлицами и ИП по безналичному расчёту: договор, счёт, закрывающие документы — акт и УПД — в срок, при необходимости через ЭДО. По запросу участвуем в закупках и тендерах.',
  },
  {
    id: 'speed',
    kicker: 'Скорость',
    title: 'Смета за 30 минут',
    text: 'Присылаем смету в течение 30 минут в рабочее время и резервируем оборудование под ваш проект на согласованные даты. Ночной монтаж и заезд до открытия площадки — штатный режим, а не исключение.',
  },
  {
    id: 'personal-contact',
    kicker: 'Контакт',
    title: 'Без колл-центра',
    text: 'Вы общаетесь напрямую с менеджером и техником, которые приедут на площадку, — без колл-центра и передачи проекта между отделами.',
  },
];

---

<Base title={title} description={description}>
  <div class="mx-auto max-w-[1200px] px-4 pt-4 sm:px-6">
    <Breadcrumbs
      items={[
        { name: HOME_LINK.label, url: HOME_LINK.href },
        { name: AGENCY_LINK.label, url: AGENCY_LINK.href },
      ]}
    />

    {/* Интро + white label (первый из пяти блоков ТЗ §5.6) в одном bento-ряду. */}
    <section id="hero" class="mt-4 grid gap-bento md:grid-cols-12">
      <div
        class={`flex min-w-0 flex-col justify-between gap-8 ${boxClass} p-6 sm:p-9 md:col-span-7`}
      >
        <div>
          <p class="font-mono text-[11.5px] tracking-[0.14em] text-dim uppercase">
            Для агентств, организаторов и корпоративных заказчиков
          </p>
          <h1
            class="mt-5 max-w-[22ch] font-display text-[clamp(28px,3.8vw,46px)] leading-[1.06] font-semibold tracking-[-0.025em] text-balance text-screen"
          >
            Агентствам и корпоративным заказчикам
          </h1>
          <p class="mt-4 max-w-[58ch] text-[17px] leading-[1.5] text-text">
            Мы работаем как подрядчик, а не как отдельный бренд на площадке: оборудование без
            нашей символики, документы под вашу бухгалтерию и смета за 30&nbsp;минут. Ниже —
            условия для регулярных заказов, работы с юрлицами и прямого контакта с теми, кто
            приедет на объект.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <button type="button" data-quiz-open data-preset={consultPreset} class={primaryButton}
            >{ctaLabel}</button
          >
          <a href={SITE.phoneHref} data-goal="click_phone" class={secondaryButton}>Позвонить</a>
        </div>
      </div>

      <div
        id="white-label"
        data-screen-in
        class="screen-on rounded-box flex min-w-0 flex-col justify-between gap-6 p-6 sm:p-8 md:col-span-5"
      >
        <p class="font-mono text-[11.5px] tracking-[0.14em] text-white/75 uppercase">
          White label
        </p>
        <div>
          <h2 class="font-display text-[clamp(20px,2.2vw,26px)] leading-[1.2] font-medium tracking-[-0.02em] text-white">
            Техники на площадке — «ваша команда»
          </h2>
          <p class="mt-4 max-w-[44ch] text-[15px] leading-[1.6] text-screen/90">
            Оборудование выезжает без наших логотипов и наклеек — никакой нашей символики на
            технике и форме. Техник представляется от вашего лица, вопросы гостей и вашего
            клиента адресует вам. Смету пришлём в Telegram, WhatsApp или на почту — куда удобно.
          </p>
        </div>
      </div>
    </section>

    {/* Агентские условия — второй блок ТЗ §5.6, текст только из SITE.agencyTerms. */}
    <section id="agency-terms" class={`cv-auto mt-20 ${boxClass} p-6 sm:p-9`}>
      <p class="font-mono text-[11.5px] tracking-[0.12em] text-focus uppercase">
        Агентские условия
      </p>
      <h2 class="mt-4 text-[20px] font-semibold text-screen">Условия для регулярных заказов</h2>
      <p class="mt-3 max-w-[68ch] text-[15.5px] leading-[1.6] text-text">
        {SITE.agencyTerms} Проговариваем их на первой встрече или в переписке — под ваш объём и
        график заказов.
      </p>
    </section>

    {/* Документы / скорость / персональный контакт — блоки 3–5 ТЗ §5.6. */}
    <section class="cv-auto mt-20 grid gap-bento sm:grid-cols-3">
      {
        blocks.map((block) => (
          <div id={block.id} class={`${boxClass} p-6`}>
            <p class="font-mono text-[11.5px] tracking-[0.12em] text-focus uppercase">
              {block.kicker}
            </p>
            <h2 class="mt-4 text-[19px] font-semibold text-screen">{block.title}</h2>
            <p class="mt-3 text-[14.5px] leading-[1.55] text-text">{block.text}</p>
          </div>
        ))
      }
    </section>

    <section id="cta" class="mt-20">
      <CtaBlock preset={consultPreset} ctaLabel={ctaLabel} />
    </section>
  </div>
</Base>
