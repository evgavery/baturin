---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { SITE } from '../config/site';
import { CONTACTS_LINK, HOME_LINK } from '../data/nav';
import Base from '../layouts/Base.astro';

// ТЗ §5.7: телефон, e-mail, мессенджеры, режим и зона работы, реквизиты. Без карт и
// виджетов — карты нет вообще (шапка/подвал уже дают эти контакты, здесь — крупно
// и в одном месте, каждый со своей целью Метрики).
const title = `Контакты — аренда экранов в Москве | ${SITE.brandName}`;
const description =
  'Телефон, e-mail, Telegram, WhatsApp и MAX. Работаем в Москве и МО, заявки принимаем круглосуточно, смету пришлём за 30 минут.';

const consultPreset = JSON.stringify({ services: ['consult'] });

const messengers = [
  { href: SITE.tgLink, goal: 'click_tg', label: 'Telegram' },
  { href: SITE.waLink, goal: 'click_wa', label: 'WhatsApp' },
  { href: SITE.maxLink, goal: 'click_max', label: 'MAX' },
];

const details = [
  {
    id: 'hours',
    kicker: 'Режим работы',
    title: 'Заявки принимаем круглосуточно',
    text: 'Форма на сайте и мессенджеры принимают заявки в любое время. Отвечаем и присылаем смету в рабочее время.',
  },
  {
    id: 'area',
    kicker: 'Зона работы',
    title: 'Москва и область',
    text: SITE.workArea,
  },
  {
    id: 'requisites',
    kicker: 'Реквизиты',
    title: 'Юридические реквизиты',
    text: SITE.requisites,
  },
];

const boxClass = 'rounded-box border border-line bg-surface';
// Ссылки лежат на «включённом» (screen-on) боксе — своя, более светлая палитра границ.
const messengerLink =
  'flex min-h-[48px] items-center justify-between gap-3 rounded-sm border border-white/20 bg-white/5 px-4 text-[15px] font-medium text-white transition-colors duration-200 hover:border-white/40';
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-[1200px] px-4 pt-4 sm:px-6">
    <Breadcrumbs
      items={[
        { name: HOME_LINK.label, url: HOME_LINK.href },
        { name: CONTACTS_LINK.label, url: CONTACTS_LINK.href },
      ]}
    />

    <section id="hero" class="mt-4 grid gap-bento md:grid-cols-12">
      <div
        class={`flex min-w-0 flex-col justify-between gap-8 ${boxClass} p-6 sm:p-9 md:col-span-7`}
      >
        <div>
          <p class="font-mono text-[11.5px] tracking-[0.14em] text-dim uppercase">
            Москва и Московская область
          </p>
          <h1
            class="mt-5 font-display text-[clamp(30px,4.2vw,46px)] leading-[1.05] font-semibold tracking-[-0.025em] text-screen"
          >
            Контакты
          </h1>
          <p class="mt-4 max-w-[52ch] text-[17px] leading-[1.5] text-text">
            Звоните или пишите в мессенджер — отвечаем в рабочее время. Заявки принимаем
            круглосуточно, смету пришлём в течение 30&nbsp;минут.
          </p>
        </div>
        <div class="flex flex-col gap-1">
          <a
            href={SITE.phoneHref}
            data-goal="click_phone"
            class="flex min-h-[44px] items-center font-mono text-[28px] text-screen transition-colors duration-200 hover:text-focus sm:text-[32px]"
            >{SITE.phone}</a
          >
          <a
            href={`mailto:${SITE.email}`}
            class="flex min-h-[44px] items-center text-[16px] text-text transition-colors duration-200 hover:text-screen"
            >{SITE.email}</a
          >
        </div>
      </div>

      <div
        id="messengers"
        class="screen-on rounded-box flex min-w-0 flex-col justify-between gap-5 p-6 sm:p-8 md:col-span-5"
      >
        <div>
          <p class="font-mono text-[11.5px] tracking-[0.14em] text-white/75 uppercase">
            Мессенджеры
          </p>
          <h2 class="mt-3 font-display text-[clamp(20px,2.2vw,26px)] leading-[1.2] font-medium tracking-[-0.02em] text-white">
            Отвечаем быстрее всего здесь
          </h2>
        </div>
        <div class="flex flex-col gap-2.5">
          {
            messengers.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener"
                data-goal={item.goal}
                class={messengerLink}
              >
                {item.label}
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Режим, зона работы и реквизиты — каждый факт прямо из SITE, без ручного ввода. */}
    <section class="mt-20 grid gap-bento sm:grid-cols-3">
      {
        details.map((item) => (
          <div id={item.id} class={`${boxClass} p-6`}>
            <p class="font-mono text-[11.5px] tracking-[0.12em] text-accent-soft uppercase">
              {item.kicker}
            </p>
            <h2 class="mt-4 text-[19px] font-semibold text-screen">{item.title}</h2>
            <p class="mt-3 text-[14.5px] leading-[1.55] text-text">{item.text}</p>
          </div>
        ))
      }
    </section>

    <section id="cta" class="mt-20">
      <CtaBlock preset={consultPreset} />
    </section>
  </div>
</Base>
