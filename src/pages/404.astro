---
import { SITE } from '../config/site';
import { CONTACTS_LINK, DIRECTION_LINKS, HOME_LINK } from '../data/nav';
import Base from '../layouts/Base.astro';

const links = [HOME_LINK, ...DIRECTION_LINKS, CONTACTS_LINK];
---

<Base
  title={`Страница не найдена | ${SITE.brandName}`}
  description="Такой страницы на сайте нет. Перейдите в нужный раздел или напишите нам — подберём оборудование и пришлём смету."
  noindex
>
  <section class="mx-auto max-w-[1200px] px-4 pt-12 pb-16 sm:px-6 sm:pt-16">
    <p class="mb-5 font-mono text-[11.5px] tracking-[0.14em] text-dim uppercase">Ошибка 404</p>
    <h1
      class="mb-4 max-w-[18ch] font-display text-[clamp(30px,4.2vw,52px)] leading-[1.05] font-semibold tracking-[-0.025em] text-balance text-screen"
    >
      Страница не найдена
    </h1>
    <p class="mb-9 max-w-[52ch] text-[17px] leading-[1.5]">
      Адрес устарел или в&nbsp;нём опечатка. Ниже&nbsp;— разделы, в&nbsp;которые чаще всего заходят;
      если нужна смета, позвоните или напишите в&nbsp;мессенджер.
    </p>

    <ul role="list" class="grid grid-cols-1 gap-bento sm:grid-cols-2 lg:grid-cols-3">
      {
        links.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex min-h-[72px] items-center justify-between gap-4 rounded-box border border-line bg-surface px-6 py-5 text-[16px] text-text transition-[border-color,box-shadow,color] duration-200 hover:border-line-on-strong hover:text-screen hover:shadow-glow-sm"
            >
              {item.label}
              <span class="font-mono text-dim" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={SITE.phoneHref}
      data-goal="click_phone"
      class="mt-9 inline-flex min-h-[48px] items-center rounded-full border border-line-strong px-6 font-mono text-[15px] text-screen transition-colors duration-200 hover:border-line-on-strong"
      >{SITE.phone}</a
    >
  </section>
</Base>
